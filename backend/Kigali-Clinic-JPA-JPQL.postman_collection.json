{
  "info": {
    "name": "Kigali Clinic - JPA & JPQL",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Part A - Derived queries",
      "item": [
        {
          "name": "A1 Patients by last name",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/patients/by-last-name?lastName=uwase",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "patients",
                "by-last-name"
              ],
              "query": [
                {
                  "key": "lastName",
                  "value": "uwase"
                }
              ]
            }
          }
        },
        {
          "name": "A2 Appointments by status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/appointments/by-status?status=SCHEDULED",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments",
                "by-status"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "SCHEDULED"
                }
              ]
            }
          }
        },
        {
          "name": "A3 Appointments between dates",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/appointments/between?start=2026-10-01&end=2026-10-31",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments",
                "between"
              ],
              "query": [
                {
                  "key": "start",
                  "value": "2026-10-01"
                },
                {
                  "key": "end",
                  "value": "2026-10-31"
                }
              ]
            }
          }
        },
        {
          "name": "A4 Save appointment (double booking -> 409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/appointments/save/{{patientId}}/{{doctorId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments",
                "save",
                "{{patientId}}",
                "{{doctorId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appointmentDate\": \"2026-10-20\",\n  \"reason\": \"Checkup\",\n  \"status\": \"SCHEDULED\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
